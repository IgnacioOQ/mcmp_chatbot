# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.env

# Project specific
# data/*.json and data/graph are TRACKED on the routines branch so the scheduled
# refresh can commit scraped datasets; only the local vector store is ignored.
data/vectordb/
*.log
mcmp_chatbot.log
debug_env.py
scripts/test_*.py
scripts/verify_*.py
.DS_Store
.streamlit/secrets.toml

# Service-account keys — never commit (this branch is public and the cloud
# routine materializes /tmp/gcp-sa-key.json at runtime; keep these out of git)
*-sa-key.json
mcmp-sa-key.json
gcp-sa-key.json

# Claude Code settings
# .claude/settings.json IS tracked on the routines branch so the SessionStart
# hook (cloud Selenium setup) persists into scheduled cloud-run sessions.
.claude/settings.local.json

# Firebase build
firebase/frontend/.env.local
firebase/frontend/node_modules/
firebase/frontend/.next/
firebase/.firebaserc
